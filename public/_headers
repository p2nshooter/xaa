# Static files are served by Cloudflare directly, before the Worker runs, so
# they carry their own copy of the security headers set in next.config.js.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/company/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=604800

# Template demos (tools/demos/import-template-demo.mjs): hashed files never change.
/demos/:slug/assets/*
  Cache-Control: public, max-age=31536000, immutable

/demos/:slug/shots/*
  Cache-Control: public, max-age=604800
