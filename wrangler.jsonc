{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "xaa-es",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "xaa-es" }],
  "vars": { "APP_URL": "https://xaa.es" },

  // Client portal storage.
  //
  // DATA (R2, private) holds every record: accounts, projects, payments,
  // template orders, PayPal checkouts, settings, investors, support. The key
  // layout is in src/server/r2/schema.ts and docs/R2-DATA-BLUEPRINT.md.
  // UPLOADS (R2, private) holds the files: client uploads, payment proofs,
  // template bundles and per-project snapshots. BACKUPS (R2, private) holds
  // the daily full backups of DATA, deleted after 35 days by its lifecycle rule.
  //
  // DB is the former D1 database. Nothing writes to it any more: the first
  // request after this release copies its records into DATA once
  // (src/server/migrate.ts) and it stays bound, read-only, for seven days as a
  // fallback copy. The database_id is filled in by
  // scripts/ensure-cloudflare-resources.sh, which CI runs before every deploy
  // and which also creates the buckets if they do not exist yet.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "xaa-data" },
    { "binding": "UPLOADS", "bucket_name": "xaa-uploads" },
    { "binding": "BACKUPS", "bucket_name": "xaa-backups" }
  ],
  // worker.ts takes a backup of DATA into BACKUPS every day at 03:17 UTC.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "xaa-portal", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ]
}
