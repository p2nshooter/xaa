{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "xaa-es",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "xaa-es" }],
  "vars": { "APP_URL": "https://xaa.es" },

  // Client portal storage — accounts, projects, milestone payments, uploads.
  //
  // The database_id below is filled in by scripts/ensure-cloudflare-resources.sh,
  // which CI runs before every deploy and which creates the database and the
  // bucket if they do not exist yet. So there is nothing to provision by hand,
  // and the placeholder is what a fresh checkout is supposed to look like.
  //
  // Locally, `npm run cf:preview` works with the placeholder as-is: wrangler's
  // local mode keys its sqlite file off the binding, not off a real id.
  //
  // The D1 schema creates itself on first use — there is no migration step.
  "d1_databases": [
    { "binding": "DB", "database_name": "xaa-portal", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "xaa-uploads" }
  ]
}
